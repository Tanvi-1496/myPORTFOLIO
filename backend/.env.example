# ==========================================
# FastAPI Portfolio Backend Environment Config
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://tanvijaware.vercel.app

# ------------------------------------------
# Contact Email Service: Resend (Primary)
# ------------------------------------------
# Get an API key at https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=vibhavari.14092006@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ------------------------------------------
# Contact Email Service: SMTP (Fallback)
# ------------------------------------------
# Used if RESEND_API_KEY is not set
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ------------------------------------------
# Optional Database: Supabase
# ------------------------------------------
# If set, messages submitted via /api/contact are also stored in contact_messages table
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ------------------------------------------
# LLM Provider for Chatbot (/api/chat)
# ------------------------------------------
# Provider: "gemini" or "anthropic"
LLM_PROVIDER=gemini
# Gemini models: gemini-2.5-flash (fast & generous free tier) or gemini-1.5-flash
# Anthropic models: claude-3-5-haiku-latest or claude-3-haiku-20240307
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# ------------------------------------------
# GitHub API Token (Optional)
# ------------------------------------------
# Increases GitHub REST rate limit from 60/hr to 5,000/hr
GITHUB_TOKEN=
